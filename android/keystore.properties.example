# Copy to keystore.properties (gitignored) after generating the keystore:
#   keytool -genkeypair -v -keystore keystore/release.jks -alias tmuxifier \
#     -keyalg RSA -keysize 4096 -validity 10000
# BACK UP keystore/release.jks and this file together, off this box — losing
# the keystore breaks update-in-place installs forever.
storeFile=keystore/release.jks
storePassword=CHANGE_ME
keyAlias=tmuxifier
keyPassword=CHANGE_ME
